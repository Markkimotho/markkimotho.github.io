<div class="project-tile">
  <a class="project-entry" href="{{ project.url | relative_url }}" aria-label="Read about {{ project.title | escape }}">
    {% if project.img %}
      <div class="project-entry-image">
        {% include figure.liquid loading="lazy" path=project.img sizes="(max-width: 575px) 100vw, (max-width: 991px) 50vw, 33vw" alt=project.title class="project-list-thumb" %}
      </div>
    {% endif %}
    <div class="project-entry-content">
      <h3>{{ project.title }}</h3>
      <p>{{ project.description }}</p>
    </div>
    <span class="project-entry-arrow" aria-hidden="true">↗</span>
  </a>
</div>
