---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post {% if page.collection == 'projects' %}portfolio-project-detail{% elsif page.portfolio_section %}portfolio-{{ page.portfolio_section }}{% endif %}">
  {% if page.collection == 'projects' %}
    <nav class="project-detail-nav" aria-label="Project navigation">
      <a href="{{ '/projects/' | relative_url }}">← All projects</a>
      {% if page.redirect -%}
        <a href="{{ page.redirect }}">Project site or source ↗</a>
      {%- endif %}
    </nav>
  {% endif %}
  <header class="post-header">
    <h1 class="post-title">
      {% if page.description_as_heading %}{{ page.description }}{% else %}{{ page.title }}{% endif %}
    </h1>
    {% unless page.description_as_heading or page.description == blank %}
      <p class="post-description">{{ page.description }}</p>
    {% endunless %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
